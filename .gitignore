# Everything in here is generated by `npm run assets` — the probe clip, the kuromoji
# dictionary, the icons — except these two, which are text a reviewer can read. The
# pattern ends in /* rather than /: git cannot re-include a file whose directory is
# itself ignored, so ignoring the contents is what makes the exceptions possible.
src/web/public/*
!src/web/public/manifest.webmanifest
!src/web/public/sw.js
