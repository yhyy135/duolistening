{
  "name": "duolistening",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "start": "node src/server/main.ts",
    "dev:server": "node --watch src/server/main.ts",
    "build": "vite build",
    "dev:web": "vite",
    "probe": "node scripts/make-probe.ts",
    "prebuild": "npm run probe",
    "predev:web": "npm run probe"
  },
  "devDependencies": {
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-storage": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@hono/node-server": "^2.1.1",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.7",
    "kuromoji": "^0.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
