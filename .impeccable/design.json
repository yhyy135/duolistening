      "css": ".ds-sta{font-family:Barlow,system-ui,sans-serif;background:var(--sta-ground,#e8eae5);color:var(--sta-ink,#14171c)}.ds-stop{position:relative;display:grid;grid-template-columns:3.25rem 2.25rem 1fr;column-gap:.75rem;padding:.7rem 0}.ds-stamp{text-align:right;padding-top:.5rem;font:700 .75rem Barlow,sans-serif;font-variant-numeric:tabular-nums}.ds-route{position:relative}.ds-route::before{content:'';position:absolute;left:calc(1.125rem - 2px);top:0;bottom:0;width:4px;background:linear-gradient(var(--sta-accent,#2b7a34) 0 .8rem,var(--sta-hairline,#cbd0c8) .8rem)}.ds-route::after{content:'';position:absolute;left:1.125rem;top:.8rem;width:1.625rem;height:1.625rem;translate:-50% -50%;border-radius:50%;background:var(--sta-raised,#fff);box-shadow:inset 0 0 0 6px var(--sta-accent,#2b7a34)}.ds-line{font:500 1.3125rem/1.6 inherit;letter-spacing:.01em}.ds-ticker{display:flex;justify-content:center;gap:1.5rem;margin:0;padding:.4rem 1rem;background:var(--sta-led-ground,#12171c);color:var(--sta-led,#ffa23e);font:700 .75rem Barlow,sans-serif;letter-spacing:.06em;font-variant-numeric:tabular-nums}.ds-off{color:var(--sta-led-off,#a8895f)}"
    }
